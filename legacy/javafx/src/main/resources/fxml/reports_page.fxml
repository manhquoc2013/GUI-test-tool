<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studio.controller.ReportsPageController"
      styleClass="reports-page">
    <FlowPane styleClass="page-toolbar" hgap="8" vgap="6" alignment="CENTER_LEFT" prefWrapLength="1100">
        <Label text="Báo cáo" styleClass="page-title"/>
        <Separator/>
        <Label text="Phạm vi" styleClass="toolbar-label"/>
        <ComboBox fx:id="scopeFilter" prefWidth="120" onAction="#onFilterChanged"/>
        <Label text="Kết quả" styleClass="toolbar-label"/>
        <ComboBox fx:id="resultFilter" prefWidth="120" onAction="#onFilterChanged"/>
        <Label text="Suite" styleClass="toolbar-label"/>
        <ComboBox fx:id="suiteFilter" prefWidth="160" onAction="#onFilterChanged"/>
        <Button text="Làm mới" fx:id="refreshBtn" onAction="#refresh" styleClass="toolbar-btn"/>
    </FlowPane>

    <!-- KPI Summary Cards -->
    <HBox spacing="12" styleClass="kpi-cards-row">
        <padding><Insets top="8" right="12" bottom="4" left="12"/></padding>

        <!-- Card 1: Tổng số lần chạy -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="Tổng số lần chạy" styleClass="small"/>
            <Label fx:id="kpiTotalRuns" text="0" styleClass="accent, kpi-value"/>
            <Label text="tổng lần thực thi" styleClass="small"/>
        </VBox>

        <!-- Card 2: Tỷ lệ Pass -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="Tỷ lệ Pass" styleClass="small"/>
            <Label fx:id="kpiPassRate" text="0%" styleClass="success, kpi-value"/>
            <Label text="tỷ lệ đạt trung bình" styleClass="small"/>
        </VBox>

        <!-- Card 3: Tổng lần PASSED -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="Lần chạy PASSED" styleClass="small"/>
            <Label fx:id="kpiPassed" text="0" styleClass="success, kpi-value"/>
            <Label text="case đạt yêu cầu" styleClass="small"/>
        </VBox>

        <!-- Card 4: Tổng lần FAILED -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="Lần chạy FAILED" styleClass="small"/>
            <Label fx:id="kpiFailed" text="0" styleClass="danger, kpi-value"/>
            <Label text="case thất bại" styleClass="small"/>
        </VBox>
    </HBox>

    <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS" styleClass="reports-table">
        <columns>
            <TableColumn text="Mã chạy" fx:id="runIdCol" prefWidth="130"/>
            <TableColumn text="Phạm vi" fx:id="scopeCol" prefWidth="90"/>
            <TableColumn text="Mục tiêu" fx:id="targetCol" prefWidth="180"/>
            <TableColumn text="Kết quả" fx:id="resultCol" prefWidth="140"/>
            <TableColumn text="Thời gian" fx:id="durationCol" prefWidth="90"/>
            <TableColumn text="Trình duyệt" fx:id="browserCol" prefWidth="100"/>
            <TableColumn text="Bắt đầu" fx:id="startedCol" prefWidth="140"/>
            <TableColumn text="Thao tác" fx:id="actionsCol" prefWidth="290"/>
        </columns>
    </TableView>
</VBox>
