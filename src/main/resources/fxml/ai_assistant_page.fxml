<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studio.controller.AiAssistantPageController"
      styleClass="ai-assistant-page" spacing="0">

    <!-- Top Toolbar -->
    <HBox styleClass="page-toolbar" spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="8" right="14" bottom="8" left="14"/></padding>
        <Label text="🤖 Trợ lý AI" styleClass="page-title"/>
        <Label text="— Tự động hóa kiểm thử thông minh với OpenAI" styleClass="page-subtitle"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="modelIndicatorLabel" text="Mô hình: gpt-4o" styleClass="ai-model-badge"/>
        <Button text="⚙️ Cài đặt OpenAI" fx:id="settingsBtn" onAction="#openSettings" styleClass="btn-secondary"/>
        <Button text="🧹 Xóa đoạn chat" fx:id="clearChatBtn" onAction="#clearChat" styleClass="btn-secondary"/>
    </HBox>

    <SplitPane dividerPositions="0.48" VBox.vgrow="ALWAYS" styleClass="ai-split-pane">
        <!-- Left Panel: Chat, Documents, & Target Suite -->
        <VBox spacing="10" styleClass="ai-left-panel">
            <padding><Insets top="10" right="12" bottom="12" left="12"/></padding>

            <!-- Target Selection Row -->
            <VBox spacing="6" styleClass="ai-target-box">
                <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                <Label text="🎯 Đích đến cho Test Cases được sinh:" styleClass="field-label-small"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Nhóm:" styleClass="field-label-dim"/>
                    <ComboBox fx:id="targetGroupCombo" promptText="Chọn Nhóm..." prefWidth="130"/>
                    <Label text="Suite:" styleClass="field-label-dim"/>
                    <ComboBox fx:id="targetSuiteCombo" promptText="Chọn Suite..." prefWidth="150" HBox.hgrow="ALWAYS"/>
                    <Button text="🔄" fx:id="refreshTargetsBtn" onAction="#reloadTargets" styleClass="icon-btn"/>
                </HBox>
            </VBox>

            <!-- Chat History Area -->
            <ScrollPane fx:id="chatScroll" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="ai-chat-scroll">
                <VBox fx:id="chatMessagesBox" spacing="12" styleClass="ai-chat-container">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                </VBox>
            </ScrollPane>

            <!-- Attached Files Container -->
            <VBox fx:id="attachedFilesBox" spacing="6" styleClass="ai-attachments-box" visible="false" managed="false">
                <Label text="📎 Tài liệu đính kèm:" styleClass="field-label-small"/>
                <FlowPane fx:id="attachedChipsPane" hgap="6" vgap="6"/>
            </VBox>

            <!-- Quick Suggestions -->
            <HBox spacing="6" alignment="CENTER_LEFT" styleClass="ai-quick-suggestions">
                <Label text="Gợi ý:" styleClass="field-label-dim"/>
                <Button text="🔐 Test Đăng nhập" onAction="#applyQuickLogin" styleClass="ai-suggestion-btn"/>
                <Button text="🛒 Test Giỏ hàng" onAction="#applyQuickCart" styleClass="ai-suggestion-btn"/>
                <Button text="📄 Phân tích tài liệu" onAction="#applyQuickDoc" styleClass="ai-suggestion-btn"/>
            </HBox>

            <!-- Input Box -->
            <VBox spacing="8" styleClass="ai-input-box">
                <TextArea fx:id="promptInputArea" prefRowCount="3" wrapText="true"
                          promptText="Nhập yêu cầu kiểm thử hoặc kịch bản cần sinh (hoặc đính kèm tài liệu/ảnh UI bên dưới)..."
                          styleClass="ai-prompt-input"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="📎 Đính kèm tài liệu / Ảnh" fx:id="attachFileBtn" onAction="#attachFiles" styleClass="btn-secondary"/>
                    <Button text="❌ Xóa đính kèm" fx:id="clearAttachmentsBtn" onAction="#clearAttachments" styleClass="icon-btn" visible="false" managed="false"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <ProgressIndicator fx:id="generationProgress" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20" visible="false" managed="false"/>
                    <Button text="🚀 Gửi yêu cầu (Enter)" fx:id="sendBtn" onAction="#sendPrompt" styleClass="toolbar-btn-run"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right Panel: Generated Test Cases Preview & Apply -->
        <VBox spacing="10" styleClass="ai-right-panel">
            <padding><Insets top="10" right="12" bottom="12" left="12"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="📋 Kết quả sinh Test Case &amp; Kịch bản" styleClass="section-header"/>
                    <Label fx:id="resultSummaryLabel" text="Chưa có kết quả. Hãy nhập yêu cầu ở khung bên trái." styleClass="section-summary" wrapText="true"/>
                </VBox>
                <Button text="⚡ Nhập vào Suite" fx:id="applyToSuiteBtn" onAction="#applyCasesToSelectedSuite" styleClass="toolbar-btn-save" disable="true"/>
            </HBox>

            <SplitPane dividerPositions="0.35" orientation="VERTICAL" VBox.vgrow="ALWAYS" styleClass="ai-preview-split">
                <!-- Cases List -->
                <VBox spacing="6">
                    <Label text="🎯 Danh sách Test Cases:" styleClass="field-label-small"/>
                    <ListView fx:id="generatedCasesListView" VBox.vgrow="ALWAYS" styleClass="ai-cases-list"/>
                </VBox>

                <!-- Case Details & Scripts -->
                <VBox spacing="8">
                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="ai-case-meta-row">
                        <Label fx:id="previewCaseNameLabel" text="—" styleClass="ai-case-title"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="previewCaseUrlLabel" text="" styleClass="field-label-dim"/>
                    </HBox>

                    <TabPane fx:id="detailTabPane" VBox.vgrow="ALWAYS" styleClass="workspace-tabs">
                        <Tab text="📝 Playwright Java Script" closable="false">
                            <TextArea fx:id="previewScriptEditor" styleClass="code-editor" wrapText="false" editable="true"
                                      promptText="// Mã Playwright Java của case sẽ hiển thị tại đây..."/>
                        </Tab>
                        <Tab fx:id="previewAssertsTab" text="☑️ Assertions (0)" closable="false">
                            <ListView fx:id="previewAssertsListView" styleClass="case-list"/>
                        </Tab>
                        <Tab text="📄 Phản hồi gốc (JSON/Raw)" closable="false">
                            <TextArea fx:id="rawResponseViewer" styleClass="code-editor" wrapText="true" editable="false"
                                      promptText="Raw response từ OpenAI..."/>
                        </Tab>
                    </TabPane>
                </VBox>
            </SplitPane>
        </VBox>
    </SplitPane>
</VBox>

