<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studio.controller.ExplorerPageController"
      styleClass="explorer-page">
    <ToolBar styleClass="page-toolbar">
        <Button text="Nhóm mới" fx:id="addGroupBtn" onAction="#addGroup" styleClass="toolbar-btn-add"/>
        <Button text="Suite mới" fx:id="addSuiteBtn" onAction="#addSuite" styleClass="toolbar-btn"/>
        <Button text="Case mới" fx:id="addCaseBtn" onAction="#addCase" styleClass="toolbar-btn"/>
        <Separator fx:id="createToolbarSep"/>
        <Button text="Sao chép" fx:id="copyBtn" onAction="#copyItem" styleClass="toolbar-btn"/>
        <Button text="Xóa" fx:id="deleteBtn" onAction="#deleteItem" styleClass="toolbar-btn-danger"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Tìm theo tên…" prefWidth="200" styleClass="toolbar-search"/>
        <Label text="Lọc" styleClass="toolbar-label"/>
        <ComboBox fx:id="statusFilter" prefWidth="180"/>
    </ToolBar>
    <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <VBox styleClass="tree-panel">
            <HBox styleClass="tree-header-box" alignment="CENTER_LEFT" spacing="6">
                <padding><Insets top="6" right="8" bottom="6" left="8"/></padding>
                <Label text="Cây dự án" styleClass="tree-hint" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <HBox fx:id="statusFilterChips" spacing="4" alignment="CENTER_RIGHT" styleClass="filter-chips-box">
                    <Button fx:id="chipAll" text="Tất cả" styleClass="filter-chip, active" onAction="#filterChipAll"/>
                    <Button fx:id="chipActive" text="Hoạt động" styleClass="filter-chip" onAction="#filterChipActive"/>
                    <Button fx:id="chipDraft" text="Nháp" styleClass="filter-chip" onAction="#filterChipDraft"/>
                    <Button fx:id="chipInactive" text="Ngừng" styleClass="filter-chip" onAction="#filterChipInactive"/>
                </HBox>
            </HBox>
            <TreeView fx:id="projectTree" VBox.vgrow="ALWAYS" styleClass="project-tree"/>
        </VBox>
        <ScrollPane fitToWidth="true" styleClass="preview-scroll">
            <VBox styleClass="preview-panel" spacing="10">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Xem trước" styleClass="preview-title"/>
                <Label fx:id="previewName" styleClass="preview-name" text="Chọn một mục"/>
                <Label fx:id="previewType" styleClass="preview-type"/>
                <Label fx:id="previewStatus" styleClass="preview-status" visible="false" managed="false"/>
                <Label fx:id="previewDesc" styleClass="preview-desc" wrapText="true"/>
                <Label fx:id="previewStats" styleClass="preview-stats" wrapText="true"/>

                <!-- Read-only detail (default) -->
                <VBox fx:id="previewViewBox" spacing="8" visible="false" managed="false" styleClass="preview-form">
                    <Label text="Thông tin" styleClass="field-label"/>
                    <Label fx:id="previewViewDesc" styleClass="preview-desc" wrapText="true" text="—"/>
                    <Label fx:id="previewViewStatus" styleClass="toolbar-label" wrapText="true"/>
                    <Label fx:id="previewViewUrl" styleClass="toolbar-label" wrapText="true" visible="false" managed="false"/>
                    <Label fx:id="previewViewBrowser" styleClass="toolbar-label" wrapText="true"/>
                    <Label fx:id="previewViewHeadless" styleClass="toolbar-label" wrapText="true"/>
                    <Label fx:id="previewCreatedLabel" styleClass="toolbar-label"/>
                    <Label fx:id="previewUpdatedLabel" styleClass="toolbar-label"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Button fx:id="previewDeleteBtn" text="Xóa" onAction="#deleteItem" styleClass="toolbar-btn-danger"/>
                        <Button fx:id="previewEditBtn" text="Sửa" onAction="#editFromPreview" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <VBox VBox.vgrow="ALWAYS"/>
                <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="field-row">
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button fx:id="openWorkspaceBtn" text="Mở Workspace" onAction="#openWorkspace"
                            styleClass="btn-primary, preview-cta" visible="false"/>
                    <Button fx:id="runNodeBtn" text="Chạy" onAction="#runNode"
                            styleClass="btn-success, preview-cta, preview-cta-run" visible="false"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </SplitPane>
</VBox>
