; Script generated by Inno Setup Script Wizard.
; Test Studio - Full Offline Windows Installer

#ifndef MyAppVersion
#define MyAppVersion "2.6.0"
#endif

#define MyAppName "Test Studio"
#define MyAppPublisher "Test Studio Team"
#define MyAppURL "https://github.com"
#define MyAppExeName "TestStudio.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
AppId={{5E973B1B-6FE8-4A1E-8B52-3A65C9D780E2}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
UsePreviousAppDir=yes
DirExistsWarning=no
CloseApplications=yes
CloseApplicationsFilter=*.exe
RestartApplications=no
AllowNoIcons=yes
OutputDir=..\dist
OutputBaseFilename=TestStudio-{#MyAppVersion}-windows-x64-Setup
SetupIconFile=..\assets\icon.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequiredOverridesAllowed=dialog
VersionInfoVersion={#MyAppVersion}
VersionInfoProductVersion={#MyAppVersion}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription={#MyAppName} Setup

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Copy all bundled application files (embedded JRE, Node, Playwright browsers, app jars)
Source: "..\target\jpackage-out\TestStudio\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
Root: HKA; Subkey: "Software\{#MyAppName}"; ValueType: string; ValueName: "CurrentVersion"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "Software\{#MyAppName}"; ValueType: string; ValueName: "InstallLocation"; ValueData: "{app}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "Software\{#MyAppName}"; ValueType: string; ValueName: "Publisher"; ValueData: "{#MyAppPublisher}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "Software\{#MyAppName}"; ValueType: string; ValueName: "LastUpdated"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletekeyifempty

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
function IsAppRunning(const FileName: string): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'), '/c tasklist /FI "IMAGENAME eq ' + FileName + '" | find /I "' + FileName + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

procedure KillApp(const FileName: string);
var
  ResultCode: Integer;
begin
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM ' + FileName + ' /T', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

function InitializeSetup(): Boolean;
var
  PromptResult: Integer;
begin
  Result := True;
  if IsAppRunning('{#MyAppExeName}') then
  begin
    if not WizardSilent then
    begin
      PromptResult := MsgBox('Test Studio đang chạy trên hệ thống.' + #13#10 + 
                             'Vui lòng bấm OK để bộ cài tự động đóng ứng dụng và tiếp tục cài đặt, hoặc Cancel để thoát.', 
                             mbConfirmation, MB_OKCANCEL);
      if PromptResult = IDCANCEL then
      begin
        Result := False;
        Exit;
      end;
    end;
    
    // Automatically close running instances before file overwrite
    KillApp('{#MyAppExeName}');
    Sleep(1000);
  end;
end;
